{
  "name": "obsidian-workout-plugin",
  "version": "1.0.0",
  "description": "Track exercises, build workouts, log sessions and chart your progress in Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": ["obsidian", "workout", "fitness", "gym"],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.1",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  }
}
